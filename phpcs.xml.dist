<?xml version="1.0"?>
<ruleset name="OverCustomise">
	<description>WordPress coding standards for OverCustomise PHP.</description>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<file>overcustomise.php</file>
	<file>includes</file>
	<file>templates</file>
	<file>scripts</file>
	<file>tests</file>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>assets/build/*</exclude-pattern>

	<config name="minimum_supported_wp_version" value="6.8"/>
	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Extra"/>
	<!-- The established codebase uses PHP short arrays throughout. -->
	<rule ref="Universal.Arrays.DisallowShortArraySyntax">
		<severity>0</severity>
	</rule>
	<!-- The one-minute print queue is an intentional production requirement. -->
	<rule ref="WordPress.WP.CronInterval.CronSchedulesInterval">
		<severity>0</severity>
	</rule>
	<!-- Test doubles intentionally colocate WordPress function and class stubs. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Universal.Files.SeparateFunctionsFromOO.Mixed">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneObjectStructurePerFile.MultipleFound">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.serialize_serialize">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.serialize_unserialize">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="overcustomise"/>
			</property>
		</properties>
	</rule>

	<!-- The plugin intentionally uses the established OC_ class prefix. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="oc"/>
				<element value="OC"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed">
		<severity>0</severity>
	</rule>
</ruleset>
