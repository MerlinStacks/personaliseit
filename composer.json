{
  "name": "customkings/overcustomise",
  "description": "WooCommerce product customiser plugin for Custom Kings",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2",
    "tecnickcom/tcpdf": "^7.0"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "digitalrevolution/php-codesniffer-baseline": "^1.3",
    "php-stubs/woocommerce-stubs": "^10.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^13.2",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.2",
    "wp-phpunit/wp-phpunit": "*"
  },
  "autoload": {
    "files": []
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "digitalrevolution/php-codesniffer-baseline": true
    },
    "optimize-autoloader": true,
    "sort-packages": true,
    "vendor-dir": "vendor"
  },
  "scripts": {
    "post-install-cmd": "@php scripts/init-tcpdf-fonts.php",
    "post-update-cmd": "@php scripts/init-tcpdf-fonts.php",
    "tcpdf:fonts": "@php scripts/init-tcpdf-fonts.php",
    "lint:php":  "@php scripts/lint-php.php",
    "phpcs":     "phpcs",
    "phpcs:baseline": "phpcs-baseline --no-exit-code",
    "phpstan":   "phpstan analyse --no-progress --memory-limit=2G",
    "test":      "phpunit --testsuite Unit",
    "test:unit": "phpunit --testsuite Unit",
    "test:all":  "phpunit",
    "quality": [
      "@lint:php",
      "@test:unit",
      "@phpcs",
      "@phpstan"
    ]
  }
}
