{
  "name": "overcustomise",
  "version": "1.17.1",
  "description": "WooCommerce product customiser for Custom Kings",
  "private": true,
  "files": [
    "assets/build",
    "assets/css/admin.css",
    "assets/css/admin",
    "assets/js/admin-customer-uploads.js",
    "includes",
    "templates",
    "vendor/autoload.php",
    "vendor/composer",
    "vendor/tecnickcom",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "overcustomise.php"
  ],
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style",
    "test:js": "node --test tests/js/*.test.mjs && npm run test:packaging",
    "test:packaging": "python3 -B tests/test_plugin_zip.py",
    "check:plugin-zip": "python3 -B scripts/check-plugin-zip.py",
    "test:e2e": "playwright test",
    "test:e2e:performance": "playwright test tests/e2e/performance.spec.js",
    "test:performance": "node scripts/check-bundle-size.mjs",
    "plugin-zip": "bash scripts/build-plugin-zip.sh"
  },
  "dependencies": {
    "@uppy/core": "^5.2.0",
    "@uppy/drag-drop": "^5.1.0",
    "@uppy/xhr-upload": "^5.2.0",
    "fabric": "^7.4.0",
    "fonteditor-core": "^2.6.3",
    "imagetracerjs": "^1.2.6",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@wordpress/scripts": "^32.6.0",
    "canvas": "^3.2.3",
    "jsdom": "^26.1.0",
    "sass": "^1.98.0"
  },
  "wp-scripts": {
    "webpack-config": "./webpack.config.js"
  }
}
