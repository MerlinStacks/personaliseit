{
  "name": "overcustomise",
  "version": "1.16.3",
  "description": "WooCommerce product customiser for Custom Kings",
  "private": true,
  "files": [
    "assets/build",
    "includes",
    "templates",
    "vendor/autoload.php",
    "vendor/composer",
    "vendor/tecnickcom",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "overcustomise.php"
  ],
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style",
    "test:js": "node --test tests/js/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:performance": "playwright test tests/e2e/performance.spec.js",
    "test:performance": "node scripts/check-bundle-size.mjs",
    "plugin-zip": "bash scripts/build-plugin-zip.sh"
  },
  "dependencies": {
    "@uppy/core": "^5.2.0",
    "@uppy/drag-drop": "^5.1.0",
    "@uppy/xhr-upload": "^5.2.0",
    "fabric": "^7.4.0",
    "fonteditor-core": "^2.6.3",
    "imagetracerjs": "^1.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@wordpress/scripts": "^32.6.0"
  },
  "wp-scripts": {
    "webpack-config": "./webpack.config.js"
  }
}
